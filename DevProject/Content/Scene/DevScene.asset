# DE_ASSET: Scene
# Dev Scene Scene Data
m_SceneObjects:
  -  # Object Data
    m_Object:
      m_Name: 40_Plane
      m_FriendlyName: Plane
# Render Component
    m_RenderComponent:
      m_IsVisible: true
      m_AffectsLighting: true
# Texture Settings
      m_TextureSettings:
        WrapMode: 10497
        WrapValue: 0
        FilterMode: 9729
        FilterValue: 1
      m_Material:
        m_SpecularIntensity: 0.5
        m_SpecularPower: 4
        m_Shader: DefaultShader
        m_BaseParam:
          Color:
            - 0.596309066
            - 1
            - 0.450980365
          IsTexture: false
# Transform Component
    m_TransformComponent:
      m_Position:
        - 0
        - 0
        - 0
      m_Rotation:
        - 0
        - 0
        - 0
      m_Scale:
        - 30
        - 0.00999999978
        - 30
      m_Moveability: 0
# Physics Component
    m_PhysicsComponent:
      m_SimulatePhysics: false
      m_SimulateGravity: true
      m_ColliderVisible: false
      m_CollisionDetectionEnabled: true
      m_CollisonDimesionOverride: false
      m_IsTrigger: false
      m_ImpulseEnabled: true
      m_StepMethod: 1
      m_Mass: 1
      m_LinearDrag: 0.5
      m_Elasticity: 0
      m_AngularDrag: 0.5
# Mesh Component
    m_MeshComponent:
      m_Mesh: SM_Plane
  -  # Object Data
    m_Object:
      m_Name: 52_DirectionalLight
      m_FriendlyName: DirectionalLight
# Render Component
    m_RenderComponent:
      m_IsVisible: true
      m_AffectsLighting: false
# Texture Settings
      m_TextureSettings:
        WrapMode: 10497
        WrapValue: 0
        FilterMode: 9729
        FilterValue: 1
      m_Material:
        m_SpecularIntensity: 0.5
        m_SpecularPower: 4
        m_Shader: DefaultShader
        m_BaseParam:
          Color:
            - 1
            - 1
            - 0
          IsTexture: false
# Transform Component
    m_TransformComponent:
      m_Position:
        - 0
        - 500
        - 0
      m_Rotation:
        - 0
        - 0
        - 0
      m_Scale:
        - 0.400000006
        - 0.400000006
        - 0.400000006
      m_Moveability: 0
# Physics Component
    m_PhysicsComponent:
      m_SimulatePhysics: false
      m_SimulateGravity: true
      m_ColliderVisible: false
      m_CollisionDetectionEnabled: false
      m_CollisonDimesionOverride: false
      m_IsTrigger: false
      m_ImpulseEnabled: true
      m_StepMethod: 1
      m_Mass: 1
      m_LinearDrag: 0.5
      m_Elasticity: 0
