        m_Shader: DefaultShader
        BaseColor:
          - 1
          - 1
          - 0
        BaseTexture: ""
# Transform Component
    m_TransformComponent:
      m_Position:
        - 0
        - 500
        - 0
      m_Rotation:
        - 0
        - 0
        - 0
      m_Scale:
        - 0.400000006
        - 0.400000006
        - 0.400000006
      m_Moveability: 0
# Physics Component
    m_PhysicsComponent:
      m_SimulatePhysics: false
      m_SimulateGravity: true
      m_ColliderVisible: false
      m_CollisionDetectionEnabled: false
      m_CollisonDimesionOverride: false
      m_IsTrigger: false
      m_ImpulseEnabled: true
      m_StepMethod: 1
      m_Mass: 1
